DB_NAME=appdb
DB_HOST=localhost
DB_PORT=5432

APP_ENV=development
HTTP_ADDR=:8080
HTTP_ALLOWED_ORIGINS=http://localhost:10000,http://127.0.0.1:10000,http://localhost:3000,http://127.0.0.1:3000
HTTP_TRUSTED_PROXY_CIDRS=
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s
DEPENDENCY_TIMEOUT=3s
PPROF_ENABLED=false
PPROF_ADDR=127.0.0.1:6060

# Tenant provisioner bounds and retry policy.
PROVISIONER_POLL_INTERVAL=5s
PROVISIONER_RETRY_INITIAL=5s
PROVISIONER_RETRY_MAXIMUM=5m
PROVISIONER_MAX_ATTEMPTS=5
PROVISIONER_CONCURRENCY=4
PROVISIONER_OPERATION_TIMEOUT=2m
PROVISIONER_SHUTDOWN_TIMEOUT=10s

MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET_NAME=synodus-files
MINIO_USE_SSL=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CHAT_CHANNEL=corta:chat:events
RATE_LIMIT_TIMEOUT=250ms
RATE_LIMIT_LOGIN_IP_LIMIT=20
RATE_LIMIT_LOGIN_IP_WINDOW=15m
RATE_LIMIT_LOGIN_IP_BURST=20
RATE_LIMIT_REGISTRATION_IP_LIMIT=5
RATE_LIMIT_REGISTRATION_IP_WINDOW=15m
RATE_LIMIT_REGISTRATION_IP_BURST=5
RATE_LIMIT_ACCOUNT_FAILURE_LIMIT=5
RATE_LIMIT_ACCOUNT_FAILURE_WINDOW=15m
RATE_LIMIT_ACCOUNT_FAILURE_BURST=5
RATE_LIMIT_ADMIN_LIMIT=60
RATE_LIMIT_ADMIN_WINDOW=15m
RATE_LIMIT_ADMIN_BURST=20

# Optional explicit URL forms override the component values in Make targets.
# BOOTSTRAP_DATABASE_URL is administrator-only and is used by make bootstrap-db.
# BOOTSTRAP_DATABASE_URL=postgres://synodus_admin:admin-secret@localhost:5432/appdb?sslmode=disable
# DATABASE_URL is reserved for the least-privileged API runtime.
# DATABASE_URL=postgres://synodus_runtime:runtime-secret@localhost:5432/appdb?sslmode=disable
# MIGRATION_DATABASE_URL=postgres://synodus_migrator:migrator-secret@localhost:5432/appdb?sslmode=disable
# PROVISIONING_DATABASE_URL=postgres://synodus_provisioner:provisioner-secret@localhost:5432/appdb?sslmode=disable
# REDIS_URL=redis://localhost:6379/0

JWT_SECRET=development-socket-ticket-secret-change-me
CURSOR_KEY_ID=development-v1
CURSOR_SECRET=development-only-cursor-secret-change-me
# During rotation, the previous key verifies already-issued cursors only.
# CURSOR_PREVIOUS_KEY_ID=development-v0
# CURSOR_PREVIOUS_SECRET=replace-with-the-previous-secret
