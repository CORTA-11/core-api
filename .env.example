DB_USER=postgres
DB_PASSWORD=1234
DB_NAME=corta
DB_HOST=localhost
DB_PORT=5432

# Auth token TTLs (optional; defaults shown)
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=168

# Must match socket-server JWT_SECRET
JWT_SECRET=your-super-secret-key-change-in-production

# Redis Pub/Sub for chat realtime (must match socket-server)
REDIS_URL=redis://localhost:6379/0
REDIS_CHAT_CHANNEL=corta:chat:events

# Shared with socket-server for /internal/team-access
INTERNAL_API_KEY=dev-internal-key-change-me
