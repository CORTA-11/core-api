DB_USER=appuser
DB_PASSWORD=secretpass
DB_NAME=appdb
DB_HOST=localhost
DB_PORT=5432

APP_ENV=development
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s
DEPENDENCY_TIMEOUT=3s
PPROF_ENABLED=false

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-development-password

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-this-development-password
MINIO_BUCKET_NAME=synodus-files
MINIO_USE_SSL=false

REDIS_HOST=localhost
REDIS_PORT=6379

# Optional explicit URL forms override the component values in Make targets.
# DATABASE_URL=postgres://appuser:secretpass@localhost:5432/appdb?sslmode=disable
# REDIS_URL=redis://localhost:6379/0

JWT_SECRET=development-only-jwt-secret-change-me
