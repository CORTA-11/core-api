#!/usr/bin/env bash
set -euo pipefail

staged_go="$(git diff --cached --name-only --diff-filter=ACMR -- '*.go')"
if [[ -n "${staged_go}" ]]; then
  unformatted="$(printf '%s\n' "${staged_go}" | xargs -r gofmt -l)"
  [[ -z "${unformatted}" ]] || { echo "staged Go files need formatting:"; echo "${unformatted}"; exit 1; }
fi
.cache/tools/gitleaks/v8.29.1/gitleaks git --staged --redact --no-banner
